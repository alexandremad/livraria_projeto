{% load static %}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Membros</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- CSS Customizado -->
    <link rel="stylesheet" href="{% static 'membros/css/style.css' %}">
</head>
<body>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-cadastro p-4 p-md-5">
                
                <!-- Cabeçalho Ficha -->
                <div class="header-igreja">
                    <img src="{% static 'membros/img/Logo.png' %}" alt="Logotipo da aplicação" width="110" height="110">
                    <h2>IGREJA PENTECOSTAL DEUS É AMOR</h2>
                    <h5>CADASTRO DE MEMBROS</h5>
                </div>

                <form method="post" enctype="multipart/form-data">
                    {% csrf_token %}

                    <!-- Seção 1: Dados Pessoais -->
                    <div class="section-title">1. DADOS PESSOAIS</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nome Completo</label>
                            {{ form.nome }}
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Sexo</label>
                            {{ form.sexo }}
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Foto 3x4</label>
                            {{ form.foto }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estado Civil</label>
                            {{ form.estado_civil }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Data de Nascimento</label>
                            {{ form.data_nascimento }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Naturalidade</label>
                            {{ form.naturalidade }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nacionalidade</label>
                            {{ form.nacionalidade }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Profissão</label>
                            {{ form.profissao }}
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">RG</label>
                            {{ form.rg }}
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">CPF</label>
                            {{ form.cpf }}
                        </div>
                    </div>

                    <!-- Seção 2: Endereço e Contato -->
                    <div class="section-title">2. ENDEREÇO E CONTATO</div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Rua/Av.</label>
                            {{ form.endereco }}
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Nº</label>
                            {{ form.numero }}
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">CEP</label>
                            {{ form.cep }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Bairro</label>
                            {{ form.bairro }}
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Cidade</label>
                            {{ form.cidade }}
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            {{ form.estado }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Celular</label>
                            {{ form.celular }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Celular Emergência</label>
                            {{ form.celular_contato }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nome Contato Emergência</label>
                            {{ form.nome_contato }}
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">E-mail</label>
                            {{ form.email }}
                        </div>
                    </div>

                    <!-- Seção 3: Dados Familiares e Saúde -->
                    <div class="section-title">3. DADOS FAMILIARES E SAÚDE</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nome do Pai</label>
                            {{ form.nome_pai }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nome da Mãe</label>
                            {{ form.nome_mae }}
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Nome do Cônjuge (caso casado)</label>
                            {{ form.nome_conjuge }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Data do Casamento</label>
                            {{ form.data_casamento }}
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Nome dos Filhos</label>
                            {{ form.nome_filhos }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Celular dos Filhos</label>
                            {{ form.celular_filho }}
                        </div>
                        
                        <div class="col-md-4 align-self-center mt-4">
                            <div class="form-check">
                                {{ form.possui_doenca }}
                                <label class="form-check-label font-weight-bold">Possui alguma doença?</label>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Qual doença / remédio controlado?</label>
                            {{ form.qual_doenca }}
                        </div>
                    </div>

                    <!-- Seção 4: Vida Ministerial -->
                    <div class="section-title">4. VIDA MINISTERIAL E DISPONIBILIDADE</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Função Ministerial</label>
                            {{ form.funcao_ministerial }}
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Data de Batismo</label>
                            {{ form.data_batismo }}
                        </div>
                        <div class="col-md-4 align-self-center mt-4">
                            <div class="form-check">
                                {{ form.lider_departamento }}
                                <label class="form-check-label font-weight-bold" for="{{ form.lider_departamento.id_for_label }}">
                                    Líder de Departamento?
                                </label>
                            </div>
                        </div>
                        
                        <!-- Campo Qual Departamento -->
                        <div class="col-md-12">
                            <label class="form-label">Qual departamento?</label>
                            {{ form.qual_departamento }}
                        </div>

                        <div class="col-12">
                            <label class="form-label d-block">Quais dias você vem no culto?</label>
                            <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded border">
                                {% for check in form.dias_culto_checkboxes %}
                                    <div class="form-check me-2">
                                        {{ check.tag }}
                                        <label class="form-check-label" for="{{ check.id_for_label }}">
                                            {{ check.choice_label }}
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Melhor dia e período para apoiar (escalas, etc.):</label>
                            {{ form.periodo_apoio }}
                        </div>

                        <div class="col-12">
                            <label class="form-label">Observações:</label>
                            {{ form.observacoes }}
                        </div>
                    </div>

                    <!-- Seção 5: Documentos para Anexar -->
                    <div class="section-title">5. DOCUMENTOS ANEXADOS (XEROX/CÓPIA)</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">CPF e RG (Cópia)</label>
                            {{ form.doc_cpf_rg }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Comprovante de Endereço</label>
                            {{ form.doc_comprovante_residencia }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Certidão de Nascimento (Solteiro)</label>
                            {{ form.doc_certidao_nascimento }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Certidão de Casamento (Casados)</label>
                            {{ form.doc_certidao_casamento }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Curso CFO</label>
                            {{ form.doc_curso_cfo }}
                        </div>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <a href="{% url 'home' %}" class="btn btn-voltar">Voltar</a>
                        <button type="submit" class="btn btn-salvar">Salvar Cadastro</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

</body>
</html>